%% ===================== Helper Functions ==================================
function laneOut = neighborLane(currentLane, deltaDeg)
    lanes = [0, 90, 180, 270];
    laneTarget = mod(currentLane + deltaDeg, 360);
    diffs = arrayfun(@(x) min(abs(laneTarget - x), 360 - abs(laneTarget - x)), lanes);
    [~, ix] = min(diffs);
    laneOut = lanes(ix);
end

function [center, angle, valid] = originalPairFallback(ids, locs)
    center = [NaN, NaN]; angle = NaN; valid = false;
    idx1 = find(ids==1, 1); idx2 = find(ids==2, 1);
    if ~isempty(idx1) && ~isempty(idx2)
        p1 = mean(locs(:,:,idx1), 1); p2 = mean(locs(:,:,idx2), 1);
        center = (p1 + p2)/2; v = p2 - p1;
        angle  = mod(atan2(v(2), v(1))*180/pi + 45, 360);
        valid  = true; return;
    end
    idx3 = find(ids==3, 1); idx4 = find(ids==4, 1);
    if ~isempty(idx3) && ~isempty(idx4)
        p1 = mean(locs(:,:,idx3), 1); p2 = mean(locs(:,:,idx4), 1);
        center = (p1 + p2)/2; v = p2 - p1;
        angle  = mod(atan2(v(2), v(1))*180/pi + 45 - 90, 360);
        valid  = true; return;
    end
end



%% --- Fallback Function Definition (with pair-specific Y-order checks) ----
function [center, angle, valid] = computeFallbackCenterAngle(ids, locs, slopeC, interceptC, xThresh)
    fprintf('fallback start \n')
    center = [NaN, NaN];
    angle = NaN;
    valid = false;

    idsList = unique(ids)';                 % unique detected IDs
    if numel(idsList) < 2, return; end      % need at least two IDs

    % Build [id, x, y] using the FIRST occurrence of each ID (as in original)
    posMap = nan(numel(idsList),3);
    for k = 1:numel(idsList)
        idk = idsList(k);
        idx = find(ids == idk, 1);          % first index with this ID
        p = mean(locs(:,:,idx), 1);         % average over samples -> [x,y]
        posMap(k,:) = [idk, p];
    end

    % Take the two leftmost by x
    posMap = sortrows(posMap, 2);
    low1 = posMap(1,:); low2 = posMap(2,:);
    pa_x = low1(2); pa_y = low1(3);
    pb_x = low2(2); pb_y = low2(3);

    % Require similar x (vertical-ish pair)
    if abs(pa_x - pb_x) / max(pa_x, pb_x) > xThresh, return; end

    % Identify the pair by sorted IDs
    ids_pair = sort([low1(1), low2(1)]);
    a = ids_pair(1); b = ids_pair(2);

    % Get positions for those IDs again (as in original)
    idxA = find(ids == a, 1);
    idxB = find(ids == b, 1);
    posA = mean(locs(:,:,idxA), 1);   % [xA, yA]
    posB = mean(locs(:,:,idxB), 1);   % [xB, yB]

    % Base heading from A -> B (degrees)
    base = atan2(posB(2) - posA(2), posB(1) - posA(1)) * 180 / pi;

    % --- Pair-specific Y ordering constraints & offsets ---
    if isequal(ids_pair, [1 3])
        y_ok = (posB(2) < posA(2));     off  = 90;
    elseif isequal(ids_pair, [2 3])
        y_ok = (posA(2) < posB(2));     off  = 180;
    elseif isequal(ids_pair, [2 4])
        y_ok = (posB(2) < posA(2));     off  = -90;
    elseif isequal(ids_pair, [1 4])
        y_ok = (posA(2) < posB(2));     off  = 0;
    else
        return;  % not whitelisted
    end
    if ~y_ok, return; end

    % Compute rough center (linear x-correction + mean y)
    mx = mean([pa_x, pb_x]);
    cx = slopeC * mx + interceptC + mx;
    cy = mean([pa_y, pb_y]);
    center = [cx, cy];

    angle = mod(base + off, 360);
    valid = true;
end

%% --- NEW: Centralized detection routine with adaptive-preprocessing rescue
function [center, angle, valid, used_preproc, marker_ids, marker_centers] = detectAndCompute(frame_input, slopeC, interceptC, xThresh, failThreshold)
    % Attempts to detect ArUco markers and compute center/angle (with fallbacks).
    % Returns per-marker centers as well.
    persistent failCount
    if isempty(failCount)
        failCount = 0;
    end
    if nargin < 5
        failThreshold = 2;
    end

    used_preproc = false;
    center = [NaN, NaN]; angle = NaN; valid = false;
    marker_ids = []; marker_centers = [];

    % Primary detection attempt on raw frame
    try
        [ids, locs] = readArucoMarker(frame_input, 'DICT_7X7_50');
    catch ME
        fprintf('readArucoMarker error on raw frame: %s\n', ME.message);
        ids = []; locs = [];
    end

    if ~isempty(ids)
        % compute marker centers (mean of corner points) for logging
        try
            nIds = numel(ids);
            centers = nan(nIds,2);
            for ii = 1:nIds
                c = mean(locs(:,:,ii), 1);   % mean of corners -> [x,y]
                centers(ii,:) = c;
            end
            marker_ids = ids(:)';               % row vector
            marker_centers = centers;           % Nx2
        catch
            marker_ids = ids(:)';
            marker_centers = [];
        end

        [center, angle, valid] = computeFallbackCenterAngle(ids, locs, slopeC, interceptC, xThresh);
        if ~valid
            [center, angle, valid] = originalPairFallback(ids, locs);
        end
    end

    if valid
        % Successful detection; reset fail counter
        failCount = 0;
        return;
    end

    % Not valid: increment fail counter and maybe try preprocessing rescue
    failCount = failCount + 1;
    fprintf('No valid center/lane detected (consecutive failures: %d)\n', failCount);

    if failCount >= failThreshold
        % Attempt rescue with adaptive histogram equalization
        used_preproc = true;
        fprintf('Applying adapthisteq preprocessing after %d failures.\n', failCount);
        try
            frame_norm = frame_input;  % assume grayscale uint8 or normalized float
            frame_pre = adapthisteq(frame_norm, 'NumTiles', [8 8], 'ClipLimit', 0.02, 'Distribution', 'rayleigh');

            try
                [ids2, locs2] = readArucoMarker(frame_pre, 'DICT_7X7_50');
            catch ME2
                fprintf('readArucoMarker error on preprocessed frame: %s\n', ME2.message);
                ids2 = []; locs2 = [];
            end

            if ~isempty(ids2)
                % compute marker centers for preprocessed detection
                try
                    nIds2 = numel(ids2);
                    centers2 = nan(nIds2,2);
                    for ii = 1:nIds2
                        c = mean(locs2(:,:,ii), 1);
                        centers2(ii,:) = c;
                    end
                    marker_ids = ids2(:)';
                    marker_centers = centers2;
                catch
                    marker_ids = ids2(:)';
                    marker_centers = [];
                end

                [center, angle, valid] = computeFallbackCenterAngle(ids2, locs2, slopeC, interceptC, xThresh);
                if ~valid
                    [center, angle, valid] = originalPairFallback(ids2, locs2);
                end
            end

            if valid
                fprintf('Preprocessing rescued detection. Resetting fail counter.\n');
                failCount = 0;
                return;
            else
                fprintf('Preprocessing attempted but did not rescue detection.\n');
            end
        catch MEp
            fprintf('Error during preprocessing attempt: %s\n', MEp.message);
            % leave failCount unchanged
        end
    end
end

%% --- NDJSON helpers -------------------------------------------------------
function write_ndjson(fid, s)
    try
        line = jsonencode(s);
    catch ME
        warn = struct('t', rel_time(), 'phase', 'LOG_WARN', 'trial', 0, 'message', ME.message);
        line = jsonencode(warn);
    end
    fprintf(fid, '%s\n', line);
end

function t = rel_time()
    % Return seconds (double) since RUN_START
    global RUN_START;
    if isempty(RUN_START)
        error('RUN_START is not set. rel_time() requires RUN_START to be defined before logging.');
    end
    t = seconds(datetime('now','TimeZone','local') - RUN_START);
end

function v = iff(cond, a, b)
    if cond, v = a; else, v = b; end
end
